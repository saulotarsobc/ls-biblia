{
  "name": "ls-biblia",
  "version": "1.1.2",
  "description": "Baixa e edita a Biblia em Lingua de Sinais",
  "author": {
    "name": "Saulo Costa"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "test": "node --experimental-strip-types src/shared/__tests__/timeline.test.ts && node --experimental-strip-types src/main/__tests__/duracao.test.ts && node --experimental-strip-types src/main/__tests__/mediaurl.test.ts && node --experimental-strip-types src/main/__tests__/catalogo.test.ts && node --experimental-strip-types src/main/__tests__/cache.test.ts",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "release": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/release.ps1",
    "release:dry": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/release.ps1 -DryRun",
    "release:notes": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/changelog.ps1",
    "release:publish": "npm run build && electron-builder --publish always",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "clear": "rimraf out dist"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "org.ls-biblia.app",
    "productName": "LS Bíblia",
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/**",
      "!node_modules/ffprobe-static/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
        "to": "bin/ffprobe.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "saulotarsobc",
        "repo": "ls-biblia",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
